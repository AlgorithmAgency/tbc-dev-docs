                <tr><td><code>Branch</code></td><td>Pick List</td><td>Website Lead Layout</td><td>Brand-specific branch values</td></tr>
                <tr><td><code>Brand</code></td><td>Pick List</td><td>Website Lead Layout</td><td>e.g. Buco SA, Timbercity, Buco Namibia</td></tr>
