<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>GF → Zoho CRM Setup Guide | Algorithm Agency</title>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
<style>
  :root {
    --dark-bg:       #05070b;
    --dark-bg2:      #0f1520;
    --dark-bg-light: #172032;
    --dark-card:     #1e293b;
    --dark-card-hover: #263348;
    --dark-text:     #f0f2f7;
    --dark-text-sub: #b8c0d4;
    --dark-text-muted: #8a94b0;
    --light-bg:      #f5f7fa;
    --light-bg-alt:  #ffffff;
    --light-text:    #0f1520;
    --light-text-sub: #4b5563;
    --light-text-muted: #6b7280;
    --accent:        #4f8cff;
    --accent-glow:   rgba(79,140,255,0.12);
    --accent2:       #00e0a0;
    --accent2-glow:  rgba(0,224,160,0.10);
    --gradient:      linear-gradient(135deg, #4f8cff 0%, #00e0a0 100%);
    --font-sans:     'Space Grotesk', -apple-system, sans-serif;
    --font-mono:     'JetBrains Mono', monospace;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html { scroll-behavior: smooth; }

  body {
    font-family: var(--font-sans);
    background: var(--dark-bg);
    color: var(--dark-text);
    font-size: 16px;
    line-height: 1.8;
  }

  /* ── GRADIENT TEXT ── */
  .gradient-text {
    background: var(--gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* ── HEADER ── */
  header {
    background: rgba(5,7,11,0.9);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255,255,255,0.06);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .header-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 16px 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .header-logo {
    width: 32px;
    height: 32px;
    background: var(--gradient);
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 14px;
    color: white;
    flex-shrink: 0;
  }

  .header-wordmark {
    font-size: 15px;
    font-weight: 700;
    color: var(--dark-text);
    letter-spacing: -0.01em;
  }

  .header-sep {
    width: 1px;
    height: 16px;
    background: rgba(255,255,255,0.12);
  }

  .header-doc {
    font-size: 13px;
    color: var(--dark-text-muted);
    font-weight: 400;
  }

  .header-badge {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    background: rgba(79,140,255,0.1);
    color: var(--accent);
    padding: 3px 10px;
    border-radius: 20px;
    border: 1px solid rgba(79,140,255,0.2);
  }

  /* ── HERO ── */
  .hero {
    background: var(--dark-bg);
    padding: 88px 2rem 72px;
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }

  .hero::before {
    content: '';
    position: absolute;
    top: -120px; right: -80px;
    width: 500px; height: 500px;
    background: radial-gradient(circle, rgba(79,140,255,0.06) 0%, transparent 70%);
    pointer-events: none;
  }

  .hero::after {
    content: '';
    position: absolute;
    bottom: -100px; left: -60px;
    width: 400px; height: 400px;
    background: radial-gradient(circle, rgba(0,224,160,0.05) 0%, transparent 70%);
    pointer-events: none;
  }

  .hero-inner {
    max-width: 1100px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .hero-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .hero-label::before {
    content: '';
    display: block;
    width: 6px;
    height: 40px;
    background: var(--gradient);
    border-radius: 3px;
  }

  .hero h1 {
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin-bottom: 20px;
    color: var(--dark-text);
  }

  .hero-sub {
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    color: var(--dark-text-sub);
    max-width: 620px;
    font-weight: 400;
    line-height: 1.7;
    margin-bottom: 36px;
  }

  .hero-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .hero-chip {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding: 4px 12px;
    border-radius: 20px;
    border: 1px solid rgba(255,255,255,0.1);
    color: var(--dark-text-muted);
    background: rgba(255,255,255,0.03);
  }

  /* ── META BAR ── */
  .meta-bar {
    background: var(--dark-bg-light);
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }

  .meta-bar-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 14px 2rem;
    display: flex;
    gap: 40px;
    flex-wrap: wrap;
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .meta-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--dark-text-muted);
  }

  .meta-value {
    font-size: 13px;
    font-weight: 500;
    color: var(--dark-text-sub);
  }

  /* ── LAYOUT ── */
  .layout {
    max-width: 1100px;
    margin: 0 auto;
    padding: 48px 2rem 88px;
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 48px;
    align-items: start;
  }

  /* ── SIDEBAR / TOC ── */
  .toc {
    position: sticky;
    top: 80px;
  }

  .toc-title {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--dark-text-muted);
    margin-bottom: 14px;
    padding-left: 2px;
  }

  .toc nav {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .toc a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border-radius: 6px;
    text-decoration: none;
    color: var(--dark-text-muted);
    font-size: 13px;
    font-weight: 500;
    transition: all 0.2s;
    border-left: 2px solid transparent;
  }

  .toc a:hover {
    background: rgba(79,140,255,0.07);
    color: var(--accent);
    border-left-color: var(--accent);
  }

  .toc a.active {
    background: rgba(79,140,255,0.07);
    color: var(--accent);
    border-left-color: var(--accent);
  }

  .toc-num {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    color: var(--accent);
    min-width: 18px;
  }

  .toc-divider {
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.06), transparent);
    margin: 8px 0;
  }

  /* ── CONTENT ── */
  .content { min-width: 0; }

  /* ── PREREQ CARD ── */
  .prereq-card {
    background: var(--dark-card);
    border: 1px solid rgba(79,140,255,0.2);
    border-radius: 12px;
    padding: 24px 28px;
    margin-bottom: 48px;
    position: relative;
    overflow: hidden;
  }

  .prereq-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: var(--gradient);
  }

  .prereq-card-label {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 12px;
  }

  .prereq-card h3 {
    font-size: 16px;
    font-weight: 700;
    color: var(--dark-text);
    margin-bottom: 16px;
  }

  .prereq-list {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px 24px;
  }

  .prereq-list li {
    font-size: 13px;
    color: var(--dark-text-sub);
    display: flex;
    align-items: flex-start;
    gap: 8px;
    line-height: 1.5;
  }

  .prereq-list li::before {
    content: '→';
    color: var(--accent2);
    font-weight: 700;
    flex-shrink: 0;
    margin-top: 1px;
  }

  /* ── SECTION ── */
  .section {
    margin-bottom: 64px;
    scroll-margin-top: 100px;
  }

  .section-header {
    display: flex;
    align-items: flex-start;
    gap: 18px;
    margin-bottom: 28px;
    padding-bottom: 20px;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }

  .section-num-block {
    width: 44px;
    height: 44px;
    background: var(--gradient);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    font-weight: 800;
    color: white;
    flex-shrink: 0;
  }

  .section-header h2 {
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--dark-text);
    line-height: 1.2;
  }

  .section-header p {
    font-size: 13px;
    color: var(--dark-text-muted);
    margin-top: 4px;
  }

  /* ── STEPS ── */
  .steps {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .step {
    background: var(--dark-card);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 10px;
    overflow: hidden;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .step:hover {
    border-color: rgba(79,140,255,0.2);
    box-shadow: 0 4px 24px rgba(79,140,255,0.06);
  }

  .step-head {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 18px 20px;
  }

  .step-dot {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: rgba(79,140,255,0.12);
    border: 1px solid rgba(79,140,255,0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 700;
    color: var(--accent);
    flex-shrink: 0;
    margin-top: 2px;
    font-family: var(--font-mono);
  }

  .step-title {
    font-size: 15px;
    font-weight: 600;
    color: var(--dark-text);
    line-height: 1.4;
  }

  .step-sub {
    font-size: 12px;
    color: var(--dark-text-muted);
    margin-top: 2px;
    font-weight: 400;
  }

  .step-body {
    padding: 0 20px 20px 60px;
    font-size: 13.5px;
    color: var(--dark-text-sub);
    line-height: 1.75;
  }

  .step-body p { margin-bottom: 10px; }
  .step-body p:last-child { margin-bottom: 0; }

  /* ── NAV PATH ── */
  .nav-path {
    display: block;
    font-family: var(--font-mono);
    font-size: 12px;
    background: var(--dark-bg);
    border: 1px solid rgba(255,255,255,0.08);
    color: var(--accent2);
    padding: 10px 14px;
    border-radius: 6px;
    margin: 10px 0;
    letter-spacing: 0.02em;
  }

  .nav-path span { color: var(--dark-text-muted); margin: 0 5px; }

  /* ── CODE BLOCK ── */
  .code-wrap { margin: 12px 0; }

  .code-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--dark-text-muted);
    margin-bottom: 4px;
  }

  .code-block {
    background: var(--dark-bg);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 8px;
    padding: 16px 18px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--accent2);
    line-height: 1.8;
    overflow-x: auto;
    white-space: pre;
  }

  /* ── TABLE ── */
  .g-table {
    width: 100%;
    border-collapse: collapse;
    margin: 14px 0;
    font-size: 13px;
  }

  .g-table th {
    background: rgba(79,140,255,0.1);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 10px 14px;
    text-align: left;
    border-bottom: 1px solid rgba(79,140,255,0.2);
  }

  .g-table td {
    padding: 10px 14px;
    border-bottom: 1px solid rgba(255,255,255,0.04);
    color: var(--dark-text-sub);
    vertical-align: top;
  }

  .g-table tr:last-child td { border-bottom: none; }
  .g-table tr:hover td { background: rgba(255,255,255,0.015); }

  .g-table code {
    font-family: var(--font-mono);
    font-size: 11.5px;
    background: rgba(79,140,255,0.08);
    color: var(--accent);
    padding: 1px 6px;
    border-radius: 4px;
  }

  /* ── TAGS ── */
  .tag {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 2px 7px;
    border-radius: 4px;
    white-space: nowrap;
  }

  .tag-req  { background: rgba(255,100,100,0.12); color: #ff6b6b; }
  .tag-opt  { background: rgba(0,224,160,0.1); color: var(--accent2); }
  .tag-hid  { background: rgba(79,140,255,0.1); color: var(--accent); }

  /* ── CALLOUTS ── */
  .callout {
    display: flex;
    gap: 12px;
    padding: 14px 16px;
    border-radius: 8px;
    margin: 12px 0;
    font-size: 13px;
    line-height: 1.65;
  }

  .callout-icon { font-size: 15px; flex-shrink: 0; margin-top: 1px; }

  .callout-info {
    background: rgba(79,140,255,0.07);
    border-left: 3px solid var(--accent);
    color: var(--dark-text-sub);
  }

  .callout-warn {
    background: rgba(255,200,50,0.07);
    border-left: 3px solid #f59e0b;
    color: var(--dark-text-sub);
  }

  .callout-success {
    background: rgba(0,224,160,0.07);
    border-left: 3px solid var(--accent2);
    color: var(--dark-text-sub);
  }

  .callout-error {
    background: rgba(255,100,100,0.07);
    border-left: 3px solid #ff6b6b;
    color: var(--dark-text-sub);
  }

  /* ── MAPPING ROWS ── */
  .map-rows { margin: 12px 0; }

  .map-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 0;
    border-bottom: 1px solid rgba(255,255,255,0.04);
    font-size: 13px;
  }

  .map-row:last-child { border-bottom: none; }

  .map-key {
    font-family: var(--font-mono);
    font-size: 12px;
    background: rgba(79,140,255,0.08);
    color: var(--accent);
    padding: 3px 10px;
    border-radius: 4px;
    min-width: 130px;
    flex-shrink: 0;
  }

  .map-arrow {
    color: var(--accent2);
    font-weight: 700;
    font-size: 14px;
  }

  .map-val {
    color: var(--dark-text-sub);
    font-size: 13px;
  }

  .map-val em {
    color: var(--dark-text-muted);
    font-style: normal;
    font-size: 12px;
  }

  /* ── CHECKLIST ── */
  .checklist {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 10px 0;
  }

  .checklist li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 13px;
    color: var(--dark-text-sub);
    line-height: 1.6;
  }

  .check-sq {
    width: 16px;
    height: 16px;
    border: 1.5px solid rgba(79,140,255,0.3);
    border-radius: 3px;
    flex-shrink: 0;
    margin-top: 3px;
    background: rgba(79,140,255,0.04);
  }

  /* ── TROUBLESHOOT ── */
  .trouble-item {
    background: var(--dark-card);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 10px;
    margin-bottom: 12px;
    overflow: hidden;
  }

  .trouble-head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 20px;
  }

  .trouble-icon {
    width: 32px;
    height: 32px;
    background: rgba(255,100,100,0.1);
    border: 1px solid rgba(255,100,100,0.2);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    flex-shrink: 0;
  }

  .trouble-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--dark-text);
  }

  .trouble-body {
    padding: 0 20px 18px 64px;
    font-size: 13px;
    color: var(--dark-text-sub);
    line-height: 1.7;
  }

  /* ── DIVIDER ── */
  .divider {
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.08), transparent);
    margin: 40px 0;
  }

  /* ── FOOTER ── */
  footer {
    background: var(--dark-bg-light);
    border-top: 1px solid rgba(255,255,255,0.06);
    padding: 40px 2rem;
    text-align: center;
  }

  .footer-inner { max-width: 1100px; margin: 0 auto; }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }

  .footer-logo-mark {
    width: 28px; height: 28px;
    background: var(--gradient);
    border-radius: 5px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 12px;
    color: white;
  }

  .footer-logo-name {
    font-weight: 700;
    font-size: 14px;
    color: var(--dark-text);
  }

  footer p {
    font-size: 12px;
    color: var(--dark-text-muted);
    line-height: 1.8;
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 768px) {
    .layout { grid-template-columns: 1fr; padding: 24px 1.25rem 60px; }
    .toc { display: none; }
    .hero { padding: 60px 1.25rem 48px; }
    .header-inner { padding: 14px 1.25rem; }
    .header-doc { display: none; }
    .meta-bar-inner { gap: 20px; padding: 12px 1.25rem; }
    .prereq-list { grid-template-columns: 1fr; }
  }

  /* ── SCROLL REVEAL ── */
  .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }

  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>
</head>
<body>

<!-- HEADER -->
<header>
  <div class="header-inner">
    <div class="header-left">
      <div class="header-logo">A</div>
      <span class="header-wordmark">Algorithm</span>
      <div class="header-sep"></div>
      <span class="header-doc">Developer Documentation</span>
    </div>
    <span class="header-badge">Internal Use Only</span>
  </div>
</header>

<!-- HERO -->
<div class="hero">
  <div class="hero-inner">
    <div class="hero-label">Setup Guide — The Building Company</div>
    <h1>Gravity Forms <span class="gradient-text">→ Zoho CRM</span><br>Integration Guide</h1>
    <p class="hero-sub">Step-by-step setup for connecting Gravity Forms to The Building Company's Zoho CRM. The CRM is already configured — this guide covers everything needed on the WordPress/GF side.</p>
    <div class="hero-chips">
      <span class="hero-chip">Gravity Forms Elite</span>
      <span class="hero-chip">Zoho CRM Add-On</span>
      <span class="hero-chip">WordPress</span>
      <span class="hero-chip">Branch Routing</span>
      <span class="hero-chip">UTM Tracking</span>
      <span class="hero-chip">Conditional Notifications</span>
    </div>
  </div>
</div>

<!-- META BAR -->
<div class="meta-bar">
  <div class="meta-bar-inner">
    <div class="meta-item">
      <span class="meta-label">Prepared By</span>
      <span class="meta-value">Algorithm Agency</span>
    </div>
    <div class="meta-item">
      <span class="meta-label">Client</span>
      <span class="meta-value">The Building Company</span>
    </div>
    <div class="meta-item">
      <span class="meta-label">Applies To</span>
